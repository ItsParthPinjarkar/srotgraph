# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/srotgraph
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/srotgraph

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
API_PREFIX=/api/v1

# AI Providers (set these to use real providers, leave empty for mocks)
# Speech Recognition
SPEECH_RECOGNITION_PROVIDER=mock  # Options: mock, whisper, deepgram, assemblyai
# Claim Extraction
CLAIM_EXTRACTION_PROVIDER=mock    # Options: mock, openai, anthropic, google
# Retrieval
RETRIEVAL_PROVIDER=mock           # Options: mock, pgvector, external

# Provider API Keys (only needed when using non-mock providers)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
