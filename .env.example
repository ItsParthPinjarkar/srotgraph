# SrotGraph Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Application
# =============================================================================

# Environment: development, staging, production, test
APP_ENV=development

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Async database URL for FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/srotgraph

# Sync database URL for migrations and background tasks
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/srotgraph

# =============================================================================
# Redis
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# API Keys (placeholder values - replace with real keys when needed)
# =============================================================================

# OpenAI (for claim extraction)
OPENAI_API_KEY=sk-placeholder

# Anthropic (for claim extraction)
ANTHROPIC_API_KEY=sk-ant-placeholder

# DeepGram (for speech recognition)
DEEPGRAM_API_KEY=dg_placeholder

# AssemblyAI (for speech recognition)
ASSEMBLYAI_API_KEY=placeholder
